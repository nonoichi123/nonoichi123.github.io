<section class="colorlib-blog" data-section="blog">
  <div class="colorlib-narrow-content">
    <div class="row">
      <div class="col-md-12">
        <span class="heading-meta">ブログ</span>
        <h2 class="colorlib-heading">Recent Blog</h2>
      </div>
    </div>
    <div class="row blog-grid">
      {% for item in blogs %}
        <div class="col-md-4 col-sm-6">
          <article class="blog-entry">
            <a
              href="{{ item.url }}"
              target="_blank"
              rel="noopener noreferrer"
              class="blog-img"
            >
              <img
                src="{{ item.image }}"
                class="img-responsive"
                alt="{{ item.imageAlt }}"
              />
            </a>
            <div class="desc">
              <span class="blog-meta">
                <small class="blog-category">{{ item.category }}</small>
              </span>
              <h3>
                <a
                  href="{{ item.url }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  >{{ item.title }}</a
                >
              </h3>
              <p><small>{{ item.description }}</small></p>
            </div>
          </article>
        </div>
      {% endfor %}
    </div>
    <div class="row">
      <div class="col-md-12">
        <span class="heading-meta instagram-heading">
          <i class="icon-instagram" aria-hidden="true"></i>
          Instagram
        </span>
        <p class="instagram-lead">
          <small>オリジナル曲を発信しています。</small>
        </p>
      </div>
    </div>
    <div class="instagram-grid">
      {% for item in instagram.posts %}
        <a
          href="{{ item.permalink }}"
          target="_blank"
          rel="noopener noreferrer"
          class="instagram-tile"
        >
          {% if item.image %}
            <img
              src="{{ item.image }}"
              alt="{{ item.caption or 'Instagram' }}"
            />
          {% endif %}
        </a>
      {% endfor %}
    </div>
    <p class="instagram-more">
      <a
        href="{{ site.instagram }}"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
      >
        <i class="icon-instagram" aria-hidden="true"></i>
        Instagram を見る
      </a>
    </p>
  </div>
</section>
