<section class="colorlib-skills" data-section="skills">
  <div class="colorlib-narrow-content">
    <div class="row">
      <div class="col-md-12">
        <span class="heading-meta">スキルセット</span>
        <h2 class="colorlib-heading">Skills</h2>
        <p>
          <small>対応可能な技術領域の一例です。ご要件に合わせて柔軟に対応します。</small>
        </p>
      </div>
    </div>

    <div class="row skill-capabilities">
      {% for group in skills %}
      <div class="col-md-12">
        <div class="skill-group">
          <h3 class="skill-group-title">{{ group.category }}</h3>
          <p class="skill-group-summary">{{ group.summary }}</p>
          <ul class="skill-list">
            {% for item in group.items %}
            <li class="skill-chip{% if item.icon %} skill-chip--icon{% endif %}">
              {% if item.icon %}
              <img
                class="skill-chip-icon"
                src="assets/images/skills/{{ item.icon }}"
                alt=""
                width="22"
                height="22"
                loading="lazy"
              />
              {% endif %}
              <span class="skill-chip-name">{{ item.name }}</span>
            </li>
            {% endfor %}
          </ul>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
