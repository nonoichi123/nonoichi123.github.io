INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

# hubno 公開お知らせ JSON（.../news/index.json）。
# ビルド時: トップの News 抜粋に使用。
# 実行時(Workers): /news/ /blog/ の SSR と sitemap.xml に使用。
# 同じトークンの /blog/index.json からブログも取得する。
NEWS_INDEX_URL=

# 任意。未設定時は NEWS_INDEX_URL の /news/ を /blog/ に置換。
# BLOG_INDEX_URL=

# 任意。canonical / sitemap 用。未設定時はリクエストの origin。
# SITE_ORIGIN=https://nonopp.jp
