<section class="colorlib-services" data-section="services">
  <div class="colorlib-narrow-content">
    <div class="row">
      <div class="col-md-12">
        <span class="heading-meta">サービス</span>
        <h2 class="colorlib-heading">Services</h2>
        <p>
          <small
            >開発・運用・AIコンサルティングまで。リモート対応に加え、週1〜からの常駐・訪問支援にも対応しています。</small
          >
        </p>
      </div>
    </div>

    <div class="service-feature-list">
      {% for item in services %}
        {% if not item.hidden %}
          <article
            class="service-feature service-feature--color-{{ item.color }}"
          >
            {% if item.image %}
              <div class="service-feature-media">
                {% if item.url %}
                  <a
                    href="{{ item.url }}"
                    {% if item.external %}
                      target="_blank" rel="noopener noreferrer"
                    {% endif %}
                  >
                    <img
                      src="{{ item.image }}"
                      alt="{{ item.imageAlt }}"
                      class="img-responsive"
                      loading="lazy"
                    />
                  </a>
                {% else %}
                  <img
                    src="{{ item.image }}"
                    alt="{{ item.imageAlt }}"
                    class="img-responsive"
                    loading="lazy"
                  />
                {% endif %}
              </div>
            {% elif item.icon %}
              <div class="service-feature-icon">
                <span class="icon"><i class="{{ item.icon }}"></i></span>
              </div>
            {% endif %}
            <div class="service-feature-body">
              <span class="service-feature-subtitle">{{ item.subtitle }}</span>
              <h3>
                {% if item.url %}
                  <a
                    href="{{ item.url }}"
                    {% if item.external %}
                      target="_blank" rel="noopener noreferrer"
                    {% endif %}
                    >{{ item.title }}{% if item.external %}
                      <span class="service-external-icon" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          width="16"
                          height="16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path
                            d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
                          />
                          <polyline points="15 3 21 3 21 9" />
                          <line x1="10" y1="14" x2="21" y2="3" /></svg></span
                      ><span class="sr-only">（新しいタブで開く）</span>
                    {% endif %}</a
                  >
                {% else %}
                  {{ item.title }}
                {% endif %}
              </h3>
              <p class="service-feature-lead">{{ item.lead }}</p>
              <p>{{ item.description }}</p>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
