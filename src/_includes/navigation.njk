<nav id="colorlib-main-menu" role="navigation" class="navbar">
  <div id="navbar" class="collapse">
    <ul>
      {% for item in navigation %}
        <li
          class="{% if item.page and (page.url | startsWith(item.link)) %}active{% elif not item.page and page.url == item.link %}active{% endif %}"
        >
          {% if item.page %}
            <a class="external" href="{{ item.link }}">{{ item.name }}</a>
          {% elif page.url == "/" %}
            <a href="#" data-nav-section="{{ item.section }}"
              >{{ item.name }}</a
            >
          {% else %}
            <a class="external" href="/#{{ item.section }}">{{ item.name }}</a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</nav>
